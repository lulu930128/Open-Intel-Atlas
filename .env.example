PORT=8790
HOST=127.0.0.1
ATLAS_DB_PATH=data/db/atlas.sqlite
ATLAS_AUTO_COLLECT=true
ATLAS_COLLECT_ON_START=true
COLLECTOR_CONCURRENCY=3
SCHEDULER_POLL_MS=5000
SCHEDULER_LEASE_MS=300000
SCHEDULER_MAX_BACKOFF_MS=86400000
SCHEDULER_MAX_CATCHUP_MS=86400000
SCHEDULER_JITTER_RATIO=0.05
HTTP_TIMEOUT_MS=12000
HTTP_MAX_RESPONSE_BYTES=5242880
RAW_PAYLOAD_MAX_BYTES=262144
HTTP_USER_AGENT=OpenIntelAtlas/1.0 local-research

# Optional provider credentials or required identification.
NVD_API_KEY=
CWA_API_KEY=
CONGRESS_API_KEY=
FRED_API_KEY=
RELIEFWEB_APP_NAME=
SEC_USER_AGENT=OpenIntelAtlas/1.0 contact@example.com
SEMANTIC_SCHOLAR_API_KEY=

# Optional per-source override. The suffix is the upper-case source id with
# punctuation converted to underscores.
# SOURCE_GDELT_DOC_ENABLED=false
# SOURCE_SEMANTIC_SCHOLAR_ENABLED=true
