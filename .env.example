PORT=8790
# Tray-only bounded fallback list used when PORT is reserved by Windows and has no listener.
ATLAS_PORT_FALLBACKS=8890,8891,8892,8893,8894,8895,8896,8897,8898,8899
HOST=127.0.0.1
ATLAS_DB_PATH=data/db/atlas.sqlite
# Formal executable publishes a readiness snapshot for local consumers.
# Custom database runtimes only publish when this path is explicitly set.
# ATLAS_ENDPOINT_STATE_PATH=data/runtime/atlas-endpoint.json
ATLAS_AUTO_COLLECT=true
ATLAS_COLLECT_ON_START=true
COLLECTOR_CONCURRENCY=3
SCHEDULER_POLL_MS=5000
SCHEDULER_LEASE_MS=300000
SCHEDULER_MAX_BACKOFF_MS=86400000
SCHEDULER_MAX_CATCHUP_MS=86400000
SCHEDULER_JITTER_RATIO=0.05
HTTP_TIMEOUT_MS=12000
HTTP_MAX_RESPONSE_BYTES=5242880
RAW_PAYLOAD_MAX_BYTES=262144
HTTP_USER_AGENT=OpenIntelAtlas/1.0 local-research

# Fail closed by default. Set only for a local personal, non-commercial runtime
# after reviewing each source's effective media policy.
ATLAS_MEDIA_USAGE_CONTEXT=unreviewed

# Fail closed by default for feeds whose terms restrict content use. Yahoo
# Taiwan Stock RSS and future reviewed feeds require this explicit local-use gate.
ATLAS_CONTENT_USAGE_CONTEXT=unreviewed

# Company News target expansion remains canary-only unless explicitly enabled.
# master_bounded derives targets from complete TWSE/TPEx company master snapshots,
# enables at most the bounded limit, and rotates the non-canary window daily.
ATLAS_COMPANY_NEWS_TARGET_MODE=canary
ATLAS_COMPANY_NEWS_MAX_ACTIVE_TARGETS=50
ATLAS_COMPANY_NEWS_DYNAMIC_CADENCE_MS=86400000

# Optional provider credentials or required identification.
NVD_API_KEY=
CWA_API_KEY=
CONGRESS_API_KEY=
FRED_API_KEY=
RELIEFWEB_APP_NAME=
SEC_USER_AGENT=OpenIntelAtlas/1.0 contact@example.com
SEMANTIC_SCHOLAR_API_KEY=

# Optional per-source override. The suffix is the upper-case source id with
# punctuation converted to underscores.
# SOURCE_GDELT_DOC_ENABLED=false
# SOURCE_SEMANTIC_SCHOLAR_ENABLED=true
# Optional rollback switches for the first TW/JP regional release. These
# sources are enabled by default in the source registry.
# SOURCE_TW_MOFA_PRESS_RELEASES_ENABLED=false
# SOURCE_TW_NCDR_ACTIVE_CAP_ALERTS_ENABLED=false
# SOURCE_JP_MOD_NEWS_ENABLED=false
# SOURCE_JP_JPCERT_ALERTS_ENABLED=false
# SOURCE_JP_JMA_EQVOL_ENABLED=false
# SOURCE_JP_FDMA_DISASTER_INFO_ENABLED=false
# SOURCE_JP_NDL_DIET_MINUTES_ENABLED=false
# METI is registered but default-disabled after compliant Node requests returned
# HTTP 403. Do not enable it until the transport gate is revalidated.
# SOURCE_JP_METI_LATEST_ENABLED=true

# Macro: opt in together after backing up the database and adopting schema v11.
# Official HTML tables/calendar; no API key required. Normal cadence: 6 hours.
# Release watch: 1-minute checks from 10 minutes before until 30 minutes after
# scheduled publication, subject to existing lease/concurrency/backoff limits.
# SOURCE_BLS_MACRO_CALENDAR_ENABLED=true
# SOURCE_BLS_CPI_RELEASE_ENABLED=true
# SOURCE_BLS_PPI_RELEASE_ENABLED=true

# BEA PCE/Core PCE, personal income and consumption; opt in both sources.
# Six percent-change indicators; index levels and full history are not included.
# SOURCE_BEA_PCE_CALENDAR_ENABLED=true
# SOURCE_BEA_PCE_RELEASE_ENABLED=true

# Extended Macro sources (schema 11); opt in each calendar/release pair.
# SOURCE_BLS_EMPLOYMENT_CALENDAR_ENABLED=true
# SOURCE_BLS_EMPLOYMENT_RELEASE_ENABLED=true
# SOURCE_BEA_GDP_CALENDAR_ENABLED=true
# SOURCE_BEA_GDP_RELEASE_ENABLED=true
# SOURCE_DOL_CLAIMS_CALENDAR_ENABLED=true
# SOURCE_DOL_CLAIMS_RELEASE_ENABLED=true
# SOURCE_FED_FOMC_CALENDAR_ENABLED=true
# SOURCE_FED_FOMC_RELEASE_ENABLED=true
# Required for DOL's official PDF: absolute path to Poppler pdftotext executable.
# MACRO_PDFTOTEXT_PATH=/path/to/pdftotext
