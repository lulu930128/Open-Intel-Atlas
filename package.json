{
  "name": "open-intel-atlas",
  "version": "1.4.0",
  "private": true,
  "description": "Open-source intelligence dashboard and AI-ready dispatch API.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/atlasServer.js",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-isolation=none",
    "verify": "npm run check && npm test",
    "probe:regional": "node scripts/verify-regional-sources.mjs",
    "verify:migration": "node scripts/verify-schema-migration.mjs",
    "verify:isolated-adoption": "node scripts/verify-isolated-adoption.mjs",
    "verify:runtime-preflight": "node scripts/verify-runtime-adoption-preflight.mjs",
    "verify:formal-adoption": "node scripts/verify-formal-regional-adoption.mjs --phase runtime",
    "verify:formal-acceptance": "node scripts/verify-formal-regional-adoption.mjs --phase product",
    "verify:regional-live-copy": "node scripts/verify-regional-live-copy-adoption.mjs",
    "audit:regional-reprocess": "node scripts/audit-regional-reprocess.mjs",
    "verify:regional-reprocess": "node scripts/verify-regional-reprocess-copy.mjs",
    "collect:company-live-acceptance": "node scripts/collect-company-live-acceptance.mjs",
    "verify:company-acceptance": "node scripts/verify-company-acceptance.mjs",
    "collect:company-news-live-acceptance": "node scripts/collect-company-news-live-acceptance.mjs",
    "verify:company-news-acceptance": "node scripts/verify-company-news-acceptance.mjs",
    "verify:company-news-runtime": "node scripts/verify-company-news-runtime.mjs",
    "tray:selftest": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/atlas-tray.ps1 -SelfTest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
